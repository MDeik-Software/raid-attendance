# Copy to .env and fill in. Next.js reads it in development; docker compose passes it to the container.
# On Vercel, enter the same values under Project Settings → Environment Variables instead.

# Public address of the app. The Battle.net redirect URL is APP_URL + /api/auth/callback.
APP_URL=http://localhost:3020

# Battle.net API client from https://develop.battle.net/access/clients
BNET_CLIENT_ID=
BNET_CLIENT_SECRET=
# Region of the characters: eu, us, kr or tw.
BNET_REGION=eu

# Comma-separated BattleTags that can edit every row, the roster and the schedule.
# Keep the quotes: an unquoted # starts a comment, which would cut "Name#1234" down to "Name".
ADMIN_BATTLETAGS=""

# Decides when a raid night counts as past (players can no longer change it).
APP_TIMEZONE=Europe/Athens

# Local testing only: shows a "sign in without Battle.net" form. Ignored in production builds.
DEV_LOGIN=1

# Database. Set both for Turso (required on Vercel, whose servers keep no files).
# Leave them empty to use a local SQLite file under DATA_DIR instead (local dev, Docker).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# DATA_DIR=./data
